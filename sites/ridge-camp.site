have     velmora/node-decoder-rf9
have     velmora/node-decoder-tr40
have     velmora/node-translator
have     velmora/c2-air
have     velmora/map-display
have     goat-transformers

feed     velmora/map-display
feed     velmora/c2-air       from=tessaline/tr-40
